# Versioned GHCR images pulled by deploy.sh.
APP_VERSION=0.1.0
IMAGE_PREFIX=ghcr.io/liorbuch/phij

# Raspberry Pi LAN address advertised by MediaMTX for WebRTC.
MEDIA_HOST=192.168.1.50
WEB_PORT=3001

# Create a remotely-managed Cloudflare Tunnel and paste its token here.
# Keep the real .env private and never commit it.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional local-development overrides. Production browsers derive the Pi host
# from the page URL.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WHEP_URL=http://localhost:8889/dog-cam/whep
SERVER_HOST=0.0.0.0
SERVER_PORT=4000
CAMERA_STALE_AFTER_SECONDS=15
STREAM_NAME=dog-cam
WHEP_URL=http://localhost:8889/dog-cam/whep
CORS_ORIGIN=*
CAMERA_ID=dog-cam
# Keep the real camera credentials in the uncommitted .env file.
CAMERA_RTSP_URL=rtsp://user:password@192.168.50.175:8554/ch2
CAMERA_RTSP_TRANSPORT=tcp
# Use copy for an H.264 source; use libx264 when the source must be transcoded.
CAMERA_VIDEO_CODEC=copy
CAMERA_BITRATE=1800k
CAMERA_AUDIO_CODEC=libopus
CAMERA_AUDIO_BITRATE=64k
CAMERA_RTSP_IO_TIMEOUT_SECONDS=15
MEDIA_MTX_RTSP_URL=rtsp://localhost:8554/dog-cam
MEDIA_MTX_API_URL=http://localhost:9997
PUBLISHER_STARTUP_GRACE_SECONDS=15
PUBLISHER_UNREADY_CHECKS=2
API_URL=http://localhost:4000
HEARTBEAT_INTERVAL_SECONDS=5
